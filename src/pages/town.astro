---
import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";
import { buildTownData } from "@utils/townData";
import Layout from "@layouts/Layout.astro";
import TownGame from "@components/town/TownGame.astro";

// 小镇联动数据全部在构建期生成:日记(最新 12 篇)、全部文章(书架归档/
// 标签图腾/搜索)、项目卡、友链、年报、每日一句。发布新文章重新部署即更新。
const townData = buildTownData(getSortedPosts(await getCollection("blogs")));
---

<Layout
  title={`小圆镇 · 像素小镇 | 张小伦的网络日志`}
  description="博客的小镇形态：在像素小镇里逛街道、串门进屋、和史莱姆居民聊天。"
>
  <script is:inline>
    // 游戏画面式页面：禁滚动 + 禁弹性过滚（内联即时生效，不受 CSS 缓存影响）
    document.documentElement.style.overflow = "hidden";
    document.documentElement.style.overscrollBehavior = "none";
  </script>
  <h1 class="sr-only">小圆镇 · 像素小镇</h1>
  <TownGame townData={townData} />
  <p class="sr-only">
    素材：Serene Village revamped by LimeZu（CC-BY 4.0）；村民形象来自
    Modern Interiors Free by LimeZu；史莱姆与室内为本站程序化原创。
    来源与许可见 /town/ASSETS.md。
  </p>
</Layout>
