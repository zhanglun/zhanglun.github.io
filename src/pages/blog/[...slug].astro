---
import Layout from "@layouts/Layout.astro";
import BlogDetail from "@components/BlogDetail";
import { getCollection, render } from "astro:content";
import type {
  InferGetStaticParamsType,
  InferGetStaticPropsType,
  GetStaticPaths,
} from "astro";

type PostResult = {
  params: {
    slug: string | number;
  };
  props?: {
    entry: any;
  };
}[];

type PagePaths = {
  params: {
    slug: string;
  };
}[];

export async function getStaticPaths() {
  const posts = await getCollection("blogs");
  const filteredPosts = posts.filter(({ data }) => !data.draft);

  let postResult: PostResult = filteredPosts.map(entry => {
    return {
      params: {
        slug: entry.id,
      },
      props: {
        entry,
      },
    };
  });

  return [...postResult];
}

getStaticPaths satisfies GetStaticPaths;

export type Params = InferGetStaticParamsType<typeof getStaticPaths>;
export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const { title, author, description, cover, ogImage, date, tags, categories } =
  entry.data;
const ogUrl = new URL(
  cover?.src || ogImage || `${title}.svg`,
  Astro.url.origin
).href;

const { Content, remarkPluginFrontmatter } = await render(entry);
---

<Layout title={title} author={author} description={description} ogImage={ogUrl}>
  <BlogDetail
    title={title}
    pubDate={date}
    tags={tags}
    categories={categories}
    readingTime={remarkPluginFrontmatter.minutesRead}
    client:load
  >
    <Content />
  </BlogDetail>

</Layout>
