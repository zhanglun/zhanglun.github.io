---
import { SITE } from "src/config";
import Layout from "@layouts/Layout.astro";
import CatNav from "@components/ara/CatNav.astro";
---

<Layout title={`归档 | ${SITE.title}`} active="archive">
  <div class="ara-body">
    <CatNav active="archive" title="归档" mark="/ara/sprites/cat.png" />
    <div class="ara-main">
      <h1 class="px">归档</h1>
      <p class="read">按年按月的归档还没有做。</p>
      <p class="muted">先从文章列表翻。</p>
      <p><a href="/blog">去文章</a></p>
    </div>
  </div>
</Layout>
