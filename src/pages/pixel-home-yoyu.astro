---
import PixelLayout from "@layouts/PixelLayout.astro";
import Banner from "@components/pixel/Banner.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";
import formatDotDate from "@utils/formatDotDate";

const posts = getSortedPosts(await getCollection("blogs")).slice(0, 6);
---

<PixelLayout
  title={`首页方案 B · yoyu 风格整页重做 · 像素版`}
  mode="full"
  active="home-b"
>
  <Banner
    compact={false}
    ctaHref="/pixel-blog"
    ctaLabel="READ THE BLOG"
  />

  <div class="px-note-bar">
    像素版首页：光标、拖尾、视线跟随、闲置屏保全开。
    <a href="/">切回正式版首页 →</a>
  </div>

  <section class="home-posts">
    <h2 class="px-heading">最新文章</h2>
    <div class="post-grid">
      {
        posts.map(post => (
          <a
            class="px-card post-card"
            href={`/pixel-blog/${post.id}`}
            data-cursor="question"
          >
            <time class="px-date" datetime={post.data.date.toISOString()}>
              {formatDotDate(post.data.date)}
            </time>
            <h3>{post.data.title}</h3>
            <p>
              {post.data.description?.replace(/^#+\s*/, "") || "（无摘要）"}
            </p>
            <span class="px-tag">{post.data.tags[0]}</span>
          </a>
        ))
      }
    </div>
    <p class="more-row">
      <a class="px-btn" href="/pixel-blog">全部文章（demo）</a>
      <a class="px-btn" href="/blog">原版列表</a>
    </p>
  </section>
</PixelLayout>

<style>
  .home-posts {
    max-width: 1080px;
    margin: 0 auto;
    padding: 10px 24px 90px;
  }

  .home-posts > .px-heading {
    font-size: clamp(24px, 3.4vw, 34px);
    margin: 0 0 20px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }

  .post-card h3 {
    font-family: var(--px-body-font);
    font-size: 17px;
    line-height: 1.5;
    margin: 8px 0 8px;
    font-weight: 600;
  }

  .post-card p {
    font-size: 13.5px;
    line-height: 1.7;
    color: #55585f;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more-row {
    display: flex;
    gap: 12px;
    margin-top: 26px;
  }
</style>
