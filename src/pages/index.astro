---
import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";
import Layout from "@layouts/Layout.astro";
import CatNav from "@components/ara/CatNav.astro";
import PostList from "@components/ara/PostList.astro";
import formatDotDate from "@utils/formatDotDate";

const posts = getSortedPosts(await getCollection("blogs"));
const latest = posts[0];
---

<Layout streetPosts={posts} active="home">
  <div class="ara-body">
    <CatNav active="home" />
    <div class="ara-main">
      <h2 class="px">最新</h2>
      {
        latest && (
          <div class="news">
            <div class="date px">{formatDotDate(latest.data.date)}</div>
            <h3>
              <a href={`/blog/${latest.id}`}>{latest.data.title}</a>
            </h3>
            <p class="read">{latest.data.description}</p>
            <p>
              <a href={`/blog/${latest.id}`}>读这篇 →</a>
            </p>
          </div>
        )
      }
      <h2 class="px">全部文章</h2>
      <PostList posts={posts.slice(0, 10)} />
    </div>
  </div>
</Layout>
