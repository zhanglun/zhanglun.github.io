---
// 像素小镇：全屏 Phaser 画布 + DOM HUD。
// HUD 与游戏经事件总线单向通行（架构对齐 Pixels 客户端，单机简化）。
// 物品栏图标直接从 farm-tiles.png（12 列、16px 格）以 CSS 精灵裁切，放大 3 倍。
const tools = [
  { name: "开垦", icon: "⛏", hint: "对草地按「用」开垦出耕地" },
  { name: "播种", icon: "🌱", hint: "对耕地按「用」种下胡萝卜" },
  { name: "浇水", icon: "💧", hint: "对作物按「用」浇水，长得更快" },
];
---

<div class="town-stage" aria-label="像素小镇小游戏">
  <div class="town-canvas" id="town-canvas"></div>

  <div class="town-hud">
    <a class="town-back px" href="/">‹ 回博客</a>
    <div class="town-stats px">
      <span class="stat">⚡ <b id="town-energy">0</b></span>
      <span class="stat quest" id="town-quest">🥕 0/3</span>
    </div>
  </div>

  <div class="town-prompt px" id="town-prompt" hidden></div>
  <div class="town-toast px" id="town-toast" hidden></div>

  <div class="town-dialog px" id="town-dialog" hidden>
    <b class="who"></b>
    <p class="text"></p>
  </div>

  <div class="town-panel" id="town-panel" hidden>
    <div class="card">
      <h2 class="px title"></h2>
      <p class="px blurb"></p>
      <p class="px hint">按 E / ESC 关闭</p>
      <div class="row">
        <a class="px go" id="town-panel-link" hidden target="_blank" rel="noreferrer"></a>
        <button class="px close" id="town-panel-close" type="button">回到小镇</button>
      </div>
    </div>
  </div>

  <p class="town-tools-hint px" id="town-tools-hint" hidden></p>
  <div class="town-tools" id="town-tools">
    {
      tools.map((t, i) => (
        <button
          class="tool"
          type="button"
          data-tool={i}
          aria-label={t.name}
          title={`${t.name}（${i + 1}）`}
        >
          <span class="tool-icon">{t.icon}</span>
          <span class="tool-name px">{t.name}</span>
        </button>
      ))
    }
  </div>

  <div class="town-touch">
    <div class="dpad" id="town-dpad">
      <button class="du" data-dir="up" type="button" aria-label="上">▲</button>
      <button class="dl" data-dir="left" type="button" aria-label="左">◀</button>
      <button class="dr" data-dir="right" type="button" aria-label="右">▶</button>
      <button class="dd" data-dir="down" type="button" aria-label="下">▼</button>
    </div>
    <div class="acts">
      <button class="btn use px" id="town-btn-use" type="button">用</button>
      <button class="btn act px" id="town-btn-act" type="button">A</button>
    </div>
  </div>

  <div class="town-intro px" id="town-intro">
    <div class="intro-card">
      <h2>小圆镇</h2>
      <p>方向键 / WASD 走动 · E 进门、说话、收获</p>
      <p>1/2/3 换工具 · 空格开垦、播种、浇水</p>
      <p class="dim">进度自动存档 · 手机用屏幕按键</p>
      <button class="px start" id="town-start" type="button">进入小镇</button>
    </div>
  </div>
</div>

<style>
  .town-stage {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: #2f5537;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .town-canvas,
  .town-canvas canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .town-hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    pointer-events: none;
    z-index: 5;
  }
  .town-back {
    pointer-events: auto;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 10px;
    text-decoration: none;
    color: #17120e;
  }
  .town-stats {
    display: flex;
    gap: 8px;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 10px;
  }
  .town-prompt,
  .town-toast {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 3px 10px;
    z-index: 5;
    white-space: nowrap;
  }
  .town-prompt { bottom: 108px; }
  .town-toast { bottom: 146px; border-color: #d0122a; color: #d0122a; }
  .town-dialog {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    width: min(560px, calc(100% - 24px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 4px 4px 0 rgb(23 18 14 / 0.7);
    padding: 8px 12px;
    z-index: 6;
  }
  .town-dialog .who {
    color: #d0122a;
    margin-right: 8px;
  }
  .town-dialog .text {
    display: inline;
    margin: 0;
  }
  .town-tools-hint {
    position: absolute;
    right: 12px;
    bottom: 66px;
    z-index: 6;
    color: #fffdf5;
    text-shadow: 1px 1px 0 #17120e;
    white-space: nowrap;
  }
  .town-tools-hint[hidden] { display: none; }
  .town-tools {
    position: absolute;
    right: 10px;
    bottom: 14px;
    display: flex;
    gap: 6px;
    z-index: 6;
  }
  .town-tools .tool {
    width: 46px;
    height: 46px;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    display: grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
  }
  .town-tools .tool.on {
    outline: 3px solid #d0122a;
    outline-offset: -1px;
  }
  .town-tools .tool-name {
    position: absolute;
    left: 50%;
    bottom: 1px;
    transform: translateX(-50%);
    font-size: 10px;
    color: #17120e;
    background: #fffdf5;
    padding: 0 2px;
    line-height: 1.1;
  }
  .town-tools .tool {
    position: relative;
  }
  .town-tools .tool-icon {
    font-size: 22px;
    line-height: 1;
    display: block;
    margin-bottom: 10px;
  }
  .town-touch {
    position: absolute;
    inset: auto 0 0 0;
    display: none;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 14px 90px;
    z-index: 6;
    pointer-events: none;
  }
  .town-touch button {
    pointer-events: auto;
  }
  .dpad {
    position: relative;
    width: 132px;
    height: 132px;
  }
  .dpad button {
    position: absolute;
    width: 44px;
    height: 44px;
    background: #fffdf5cc;
    border: 2px solid #17120e;
    font-size: 13px;
  }
  .dpad .du { left: 44px; top: 0; }
  .dpad .dl { left: 0; top: 44px; }
  .dpad .dr { left: 88px; top: 44px; }
  .dpad .dd { left: 44px; top: 88px; }
  .acts {
    display: grid;
    gap: 8px;
  }
  .acts .btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fffdf5cc;
    border: 2px solid #17120e;
  }
  .acts .use { background: #ffe9b8cc; }
  .acts .act { background: #ffd2d2cc; }
  @media (pointer: coarse) {
    .town-touch { display: flex; }
    .town-tools { bottom: auto; top: 52px; }
  }
  .town-panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.45);
    z-index: 8;
  }
  .town-panel .card {
    width: min(420px, calc(100% - 40px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 6px 6px 0 rgb(23 18 14 / 0.6);
    padding: 16px 18px;
  }
  .town-panel .title {
    margin: 0 0 6px;
    color: #d0122a;
  }
  .town-panel .blurb {
    margin: 0 0 8px;
    line-height: 1.6;
  }
  .town-panel .hint {
    margin: 0 0 10px;
    opacity: 0.55;
    font-size: 12px;
  }
  .town-panel .row {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .town-panel .go,
  .town-panel .close {
    background: #17120e;
    color: #fffdf5;
    border: 0;
    padding: 6px 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .town-panel .go { background: #d0122a; }
  .town-intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.72);
    z-index: 9;
  }
  .town-intro .intro-card {
    text-align: center;
    color: #fffdf5;
    line-height: 2;
  }
  .town-intro h2 {
    font-size: 30px;
    letter-spacing: 6px;
    margin: 0 0 8px;
  }
  .town-intro .dim { opacity: 0.65; }
  .town-intro .start {
    margin-top: 10px;
    background: #d0122a;
    color: #fff;
    border: 2px solid #fffdf5;
    padding: 8px 22px;
    cursor: pointer;
  }
  .town-intro[hidden] { display: none; }
  .town-panel[hidden] { display: none; }
  .town-dialog[hidden] { display: none; }
  .town-prompt[hidden],
  .town-toast[hidden] { display: none; }
</style>

<script>
  import { bus, EV } from "./game/state";

  // 未捕获错误可视化（仅出错时出现）
  window.addEventListener("error", e => {
    let el = document.getElementById("town-errbar");
    if (!el) {
      el = document.createElement("div");
      el.id = "town-errbar";
      el.style.cssText =
        "position:fixed;bottom:0;left:0;right:0;z-index:99;background:#a00;color:#fff;font:11px monospace;padding:4px;max-height:120px;overflow:auto;white-space:pre-wrap";
      document.body.appendChild(el);
    }
    el.textContent += `\n${e.message}\n${e.filename}:${e.lineno}:${e.colno}\n${
      e.error?.stack ?? ""
    }`;
  });

  const $ = (id: string) => document.getElementById(id);
  const promptEl = $("town-prompt")!;
  const toastEl = $("town-toast")!;
  const dialogEl = $("town-dialog")!;
  const panelEl = $("town-panel")!;
  const introEl = $("town-intro")!;
  const energyEl = $("town-energy")!;
  const questEl = $("town-quest")!;

  bus.on(EV.ready, () => introEl.querySelector("button")?.removeAttribute("disabled"));
  bus.on(EV.prompt, (text: string | null) => {
    if (!text) {
      promptEl.hidden = true;
      return;
    }
    promptEl.textContent = text;
    promptEl.hidden = false;
  });
  bus.on(EV.energy, (n: number) => (energyEl.textContent = String(n)));
  bus.on(EV.quest, (q: { delivered: number; need: number; done: boolean }) => {
    questEl.textContent = q.done ? "🥕 任务完成 ✓" : `🥕 ${q.delivered}/${q.need}`;
  });
  let dialogTimer = 0;
  bus.on(EV.dialog, (d: { name: string; text: string } | null) => {
    if (!d) {
      dialogEl.hidden = true;
      return;
    }
    dialogEl.querySelector(".who")!.textContent = d.name;
    dialogEl.querySelector(".text")!.textContent = d.text;
    dialogEl.hidden = false;
    window.clearTimeout(dialogTimer);
    dialogTimer = window.setTimeout(() => (dialogEl.hidden = true), 4200);
  });
  let toastTimer = 0;
  bus.on(EV.toast, (text: string) => {
    // toast 独立元素，不污染场景正在显示的交互提示
    toastEl.textContent = text;
    toastEl.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toastEl.hidden = true), 1800);
  });
  bus.on(
    EV.panel,
    (
      p: { title: string; blurb: string; link?: { label: string; href: string } } | null
    ) => {
      if (!p) {
        panelEl.hidden = true;
        return;
      }
      panelEl.querySelector(".title")!.textContent = p.title;
      panelEl.querySelector(".blurb")!.textContent = p.blurb;
      const go = $("town-panel-link") as HTMLAnchorElement;
      if (p.link) {
        go.hidden = false;
        go.href = p.link.href;
        go.textContent = p.link.label;
      } else go.hidden = true;
      panelEl.hidden = false;
    }
  );

  $("town-panel-close")!.addEventListener("click", () => {
    panelEl.hidden = true;
    bus.emit(EV.panel, null);
  });

  // 工具选择：HUD 高亮与场景状态分离，避免 emit 自环
  const toolBtns = [...document.querySelectorAll<HTMLButtonElement>("#town-tools .tool")];
  const toolHintEl = $("town-tools-hint")!;
  const TOOL_HINTS = [
    "对草地按「用」开垦出耕地",
    "对耕地按「用」种下胡萝卜",
    "对作物按「用」浇水，长得更快",
  ];
  const markTool = (i: number) => {
    toolBtns.forEach((b, j) => b.classList.toggle("on", i === j));
    toolHintEl.textContent = TOOL_HINTS[i] ?? "";
    toolHintEl.hidden = false;
  };
  toolBtns.forEach(b =>
    b.addEventListener("click", () => {
      const i = Number(b.dataset.tool);
      markTool(i);
      bus.emit(EV.tool, i);
    })
  );
  bus.on(EV.tool, (i: number) => markTool(i));
  markTool(0);

  // 虚拟方向键（pointer 事件，支持按住）
  const dpad = $("town-dpad")!;
  const dirs: Record<string, [number, number]> = {
    up: [0, -1],
    down: [0, 1],
    left: [-1, 0],
    right: [1, 0],
  };
  const held = new Set<string>();
  function sendDir() {
    let dx = 0;
    let dy = 0;
    for (const d of held) {
      dx += dirs[d][0];
      dy += dirs[d][1];
    }
    bus.emit(EV.touchDir, { dx, dy, pressed: held.size > 0 });
  }
  dpad.querySelectorAll("button").forEach(b => {
    const dir = b.dataset.dir!;
    const on = (e: PointerEvent) => {
      e.preventDefault();
      try {
        b.setPointerCapture(e.pointerId);
      } catch {
        // 合成事件/无活跃指针时捕获失败不影响按住状态
      }
      held.add(dir);
      sendDir();
    };
    const off = () => {
      held.delete(dir);
      sendDir();
    };
    b.addEventListener("pointerdown", on);
    b.addEventListener("pointerup", off);
    b.addEventListener("pointercancel", off);
    b.addEventListener("pointerleave", off);
  });
  $("town-btn-act")!.addEventListener("click", () => bus.emit(EV.touchAct));
  $("town-btn-use")!.addEventListener("click", () => bus.emit(EV.touchUse));

  // 启动：点「进入小镇」时才拉起 Phaser（按需加载，键盘锁定前先显示说明）
  let started = false;
  $("town-start")!.addEventListener("click", async () => {
    if (started) return;
    started = true;
    introEl.hidden = true;
    const { startTown } = await import("./game/scenes");
    (window as unknown as { __townGame: unknown }).__townGame = startTown(
      $("town-canvas")!
    );
  });

  // 存档由游戏内 8s 心跳与关键动作驱动；不做 pagehide 持久化，
  // 避免页面卸载时用过期的内存态覆盖较新的存档。
</script>
