---
// 像素小镇：全屏 Phaser 画布 + DOM HUD。
// HUD 与游戏经事件总线单向通行（架构对齐 Pixels 客户端，单机简化）。
// 联动内容(日记/归档/项目/友链/年报…)由构建期注入的 town-data 驱动,
// HUD 与游戏场景各自从 #town-data 解析(DOM 是跨模块实例的共享通道)。
import type { TownData } from "@/utils/townData";

export interface Props {
  townData: TownData;
}
const { townData } = Astro.props;
---

<div class="town-stage" aria-label="像素小镇">
  <div class="town-canvas" id="town-canvas"></div>

  <div class="town-hud">
    <a class="town-back px" href="/">‹ 回博客</a>
    <div class="town-hud-right">
      <button class="town-tod px" id="town-map" type="button" aria-label="开关小地图">🗺 地图</button>
      <button class="town-tod px" id="town-sound" type="button" aria-label="切换音效">🔇 静音</button>
      <button class="town-tod px" id="town-tod" type="button" aria-label="切换白天黑夜">昼夜:自动</button>
    </div>
  </div>

  <div class="town-map px" id="town-map-panel" hidden>
    <div class="map-card">
      <header>
        <h2 class="px">小圆镇地图</h2>
        <span class="px page-ind">M 开关 · 点建筑传送</span>
      </header>
      <svg id="map-svg" role="img" aria-label="小镇地图:五栋建筑与玩家位置"></svg>
    </div>
  </div>

  <div class="town-guide px" id="town-guide" hidden></div>

  <div class="town-prompt px" id="town-prompt" hidden></div>
  <div class="town-toast px" id="town-toast" hidden></div>

  <div class="town-dialog px" id="town-dialog" hidden>
    <b class="who"></b>
    <p class="text"></p>
  </div>

  <div class="town-panel" id="town-panel" hidden>
    <div class="card">
      <h2 class="px title"></h2>
      <p class="px blurb"></p>
      <p class="px hint">按 E / ESC 关闭</p>
      <div class="row">
        <a class="px go" id="town-panel-link" hidden target="_blank" rel="noreferrer"></a>
        <button class="px close" id="town-panel-close" type="button">回到小镇</button>
      </div>
    </div>
  </div>

  <div class="town-list" id="town-list" hidden>
    <div class="list-card">
      <header>
        <h2 class="px" id="list-title"></h2>
        <span class="px page-ind" id="list-ind"></span>
      </header>
      <p class="px blurb" id="list-blurb" hidden></p>
      <div class="list-items px" id="list-items"></div>
      <div class="row">
        <button class="px close" id="list-close" type="button">合上</button>
      </div>
    </div>
  </div>

  <div class="town-search" id="town-search" hidden>
    <div class="list-card">
      <header>
        <h2 class="px">搜一搜</h2>
        <span class="px page-ind">标题 / 标签</span>
      </header>
      <input class="px" id="search-input" type="text" placeholder="输入关键词,回车打开第一条" autocomplete="off" />
      <div class="list-items px" id="search-results"></div>
      <div class="row">
        <button class="px close" id="search-close" type="button">合上</button>
      </div>
    </div>
  </div>

  <div class="town-diary" id="town-diary" hidden>
    <div class="diary-card">
      <header>
        <h2 class="px">小镇日记</h2>
        <span class="px page-ind" id="diary-ind"></span>
      </header>
      <div class="diary-body" id="diary-body"></div>
      <div class="row">
        <button class="px" id="diary-prev" type="button">◀ 上一篇</button>
        <a class="px go" id="diary-go" href="#">去读这篇</a>
        <button class="px" id="diary-next" type="button">下一篇 ▶</button>
        <button class="px close" id="diary-close" type="button">合上</button>
      </div>
    </div>
  </div>

  <div class="town-touch">
    <div class="dpad" id="town-dpad">
      <button class="du" data-dir="up" type="button" aria-label="上">▲</button>
      <button class="dl" data-dir="left" type="button" aria-label="左">◀</button>
      <button class="dr" data-dir="right" type="button" aria-label="右">▶</button>
      <button class="dd" data-dir="down" type="button" aria-label="下">▼</button>
    </div>
    <div class="acts">
      <button class="btn act px" id="town-btn-act" type="button">A</button>
    </div>
  </div>

  <div class="town-intro px" id="town-intro">
    <div class="intro-card">
      <h2>小圆镇</h2>
      <p>方向键 / WASD 走动 · E 进门、说话</p>
      <p class="dim">这就是博客的小镇形态 · 手机用屏幕按键</p>
      <button class="px start" id="town-start" type="button">进入小镇</button>
    </div>
  </div>
</div>

<script type="application/json" id="town-data" set:html={JSON.stringify(townData)} />

<style>
  .town-stage {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: #2f5537;
    transition: background 0.4s;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .town-canvas,
  .town-canvas canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .town-hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    pointer-events: none;
    z-index: 5;
  }
  .town-hud-right {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }
  .town-tod {
    pointer-events: auto;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 10px;
    font-size: 12px;
    color: #17120e;
    cursor: pointer;
  }
  .town-back {
    pointer-events: auto;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 10px;
    text-decoration: none;
    color: #17120e;
  }
  .town-prompt {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 108px;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 3px 10px;
    z-index: 5;
    white-space: nowrap;
  }
  .town-toast {
    position: absolute;
    top: 52px;
    left: 12px;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 3px 10px;
    z-index: 7;
    font-size: 12px;
  }
  .town-toast[hidden] { display: none; }
  /* 拍照模式:P 键截图瞬间隐藏全部 HUD */
  .town-stage.town-photo .town-hud,
  .town-stage.town-photo .town-touch,
  .town-stage.town-photo .town-prompt,
  .town-stage.town-photo .town-dialog,
  .town-stage.town-photo .town-map,
  .town-stage.town-photo .town-guide,
  .town-stage.town-photo .town-toast {
    display: none !important;
  }
  .town-dialog {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    width: min(560px, calc(100% - 24px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 4px 4px 0 rgb(23 18 14 / 0.7);
    padding: 8px 12px;
    z-index: 6;
  }
  .town-dialog .who {
    color: #d0122a;
    margin-right: 8px;
  }
  .town-dialog .text {
    display: inline;
    margin: 0;
  }
  .town-touch {
    position: absolute;
    inset: auto 0 0 0;
    display: none;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 14px 90px;
    z-index: 6;
    pointer-events: none;
  }
  .town-touch button {
    pointer-events: auto;
  }
  .dpad {
    position: relative;
    width: 132px;
    height: 132px;
  }
  .dpad button {
    position: absolute;
    width: 44px;
    height: 44px;
    background: #fffdf5cc;
    border: 2px solid #17120e;
    font-size: 13px;
  }
  .dpad .du { left: 44px; top: 0; }
  .dpad .dl { left: 0; top: 44px; }
  .dpad .dr { left: 88px; top: 44px; }
  .dpad .dd { left: 44px; top: 88px; }
  .acts {
    display: grid;
    gap: 8px;
  }
  .acts .btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #ffd2d2cc;
    border: 2px solid #17120e;
  }
  @media (pointer: coarse) {
    .town-touch { display: flex; }
  }
  .town-panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.45);
    z-index: 8;
  }
  .town-panel .card {
    width: min(420px, calc(100% - 40px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 6px 6px 0 rgb(23 18 14 / 0.6);
    padding: 16px 18px;
  }
  .town-panel .title {
    margin: 0 0 6px;
    color: #d0122a;
  }
  .town-panel .blurb {
    margin: 0 0 8px;
    line-height: 1.6;
  }
  .town-panel .hint {
    margin: 0 0 10px;
    opacity: 0.55;
    font-size: 12px;
  }
  .town-panel .row {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .town-panel .go,
  .town-panel .close {
    background: #17120e;
    color: #fffdf5;
    border: 0;
    padding: 6px 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .town-panel .go { background: #d0122a; }
  .town-intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.72);
    z-index: 9;
  }
  .town-intro .intro-card {
    text-align: center;
    color: #fffdf5;
    line-height: 2;
  }
  .town-intro h2 {
    font-size: 30px;
    letter-spacing: 6px;
    margin: 0 0 8px;
  }
  .town-intro .dim { opacity: 0.65; }
  .town-intro .start {
    margin-top: 10px;
    background: #d0122a;
    color: #fff;
    border: 2px solid #fffdf5;
    padding: 8px 22px;
    cursor: pointer;
  }
  .town-diary {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.55);
    z-index: 9;
  }
  .town-diary[hidden] { display: none; }
  .town-diary .diary-card {
    width: min(520px, calc(100% - 40px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 6px 6px 0 rgb(23 18 14 / 0.6);
    padding: 16px 18px 14px;
  }
  .town-diary header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid #17120e;
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  .town-diary h2 {
    margin: 0;
    font-size: 18px;
    color: #d0122a;
  }
  .town-diary .page-ind { font-size: 12px; color: #55585f; }
  .town-diary .diary-body { min-height: 120px; }
  .town-diary .entry-date {
    margin: 0 0 4px;
    font-size: 12px;
    color: #d0122a;
  }
  .town-diary .entry-title {
    margin: 0 0 8px;
    font-size: 17px;
    line-height: 1.45;
  }
  .town-diary .entry-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: #44444a;
  }
  .town-diary .entry-tags {
    margin: 8px 0 0;
    font-size: 12px;
    color: #8a8478;
  }
  .town-diary .row {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .town-diary .row button,
  .town-diary .row .go {
    background: #17120e;
    color: #fffdf5;
    border: 0;
    padding: 6px 10px;
    font-size: 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .town-diary .row .go { background: #d0122a; }
  .town-diary .row .close { margin-left: auto; background: #55585f; }
  .town-intro[hidden] { display: none; }
  .town-panel[hidden] { display: none; }
  .town-dialog[hidden] { display: none; }
  .town-prompt[hidden] { display: none; }

  /* ---- 列表面板 / 搜索浮层(归档、项目、标签、友链、年报、搜索共用) ---- */
  .town-list,
  .town-search {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.55);
    z-index: 9;
  }
  .town-list[hidden],
  .town-search[hidden] { display: none; }
  .list-card {
    width: min(560px, calc(100% - 40px));
    max-height: min(78vh, 640px);
    display: flex;
    flex-direction: column;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 6px 6px 0 rgb(23 18 14 / 0.6);
    padding: 16px 18px 14px;
  }
  .list-card header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid #17120e;
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  .list-card h2 {
    margin: 0;
    font-size: 18px;
    color: #d0122a;
  }
  .list-card .page-ind { font-size: 12px; color: #55585f; }
  .list-card .blurb {
    margin: 0 0 8px;
    font-size: 13px;
    line-height: 1.6;
    color: #44444a;
  }
  .list-items {
    flex: 1;
    overflow-y: auto;
    min-height: 60px;
  }
  .list-items a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    justify-content: space-between;
    padding: 7px 6px;
    border-bottom: 1px dashed #d8d3c0;
    text-decoration: none;
    color: #17120e;
  }
  .list-items a:hover { background: #f4ecd8; }
  .list-items .li-main { display: block; min-width: 0; }
  .list-items .li-t {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .list-items .li-d {
    display: block;
    font-size: 12px;
    color: #55585f;
    margin-top: 2px;
  }
  .list-items .li-m {
    font-size: 11.5px;
    color: #8a8478;
    white-space: nowrap;
  }
  .list-items .empty {
    text-align: center;
    color: #8a8478;
    font-size: 13px;
    padding: 18px 0;
    margin: 0;
  }
  #search-input {
    width: 100%;
    box-sizing: border-box;
    border: 2px solid #17120e;
    background: #fff;
    padding: 7px 10px;
    font-size: 14px;
    margin-bottom: 8px;
    outline: none;
  }
  #search-input:focus { border-color: #d0122a; }
  .list-card .row {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
  }
  .list-card .row .close {
    background: #55585f;
    color: #fffdf5;
    border: 0;
    padding: 6px 12px;
    font-size: 12px;
    cursor: pointer;
  }

  /* ---- 小地图(M 键 / 🗺 按钮,非模态;点建筑传送) ---- */
  .town-map {
    position: absolute;
    top: 52px;
    right: 12px;
    z-index: 8;
  }
  .town-map[hidden] { display: none; }
  .map-card {
    width: min(340px, calc(100vw - 24px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 4px 4px 0 rgb(23 18 14 / 0.6);
    padding: 10px 12px;
  }
  .map-card header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .map-card h2 {
    margin: 0;
    font-size: 14px;
    color: #d0122a;
  }
  .map-card .page-ind { font-size: 11px; color: #55585f; }
  #map-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* SVG 子元素由 JS 创建,不带 Astro 作用域属性,
     样式须经 :global() 命中;字号等写成正内联属性 */
  #map-svg :global(rect[data-id]) { cursor: pointer; }
  #map-svg :global(rect[data-id]:hover) { fill: #c9884f; }

  /* ---- 首次引导条(首次互动或 12s 后消失,只出现一次) ---- */
  .town-guide {
    position: absolute;
    top: 52px;
    left: 50%;
    transform: translateX(-50%);
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 12px;
    z-index: 7;
    font-size: 12px;
    white-space: nowrap;
  }
  .town-guide[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .town-stage { transition: none !important; }
  }
</style>

<script>
  import Fuse from "fuse.js";
  import { bus, EV, TOD, setTod } from "./game/state";
  import { buildings, WORLD_W, WORLD_H } from "./game/world";
  import type { TownDataClient } from "./game/towndata";

  // 未捕获错误可视化（仅出错时出现）
  window.addEventListener("error", e => {
    let el = document.getElementById("town-errbar");
    if (!el) {
      el = document.createElement("div");
      el.id = "town-errbar";
      el.style.cssText =
        "position:fixed;bottom:0;left:0;right:0;z-index:99;background:#a00;color:#fff;font:11px monospace;padding:4px;max-height:120px;overflow:auto;white-space:pre-wrap";
      document.body.appendChild(el);
    }
    el.textContent += `\n${e.message}\n${e.filename}:${e.lineno}:${e.colno}\n${
      e.error?.stack ?? ""
    }`;
  });

  const $ = (id: string) => document.getElementById(id);
  const promptEl = $("town-prompt")!;
  const dialogEl = $("town-dialog")!;
  const panelEl = $("town-panel")!;
  const introEl = $("town-intro")!;

  bus.on(EV.ready, () => introEl.querySelector("button")?.removeAttribute("disabled"));
  bus.on(EV.prompt, (text: string | null) => {
    if (!text) {
      promptEl.hidden = true;
      return;
    }
    promptEl.textContent = text;
    promptEl.hidden = false;
  });
  let dialogTimer = 0;
  let typeTimer = 0;
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  bus.on(EV.dialog, (d: { name: string; text: string } | null) => {
    if (!d) {
      dialogEl.hidden = true;
      return;
    }
    dialogEl.querySelector(".who")!.textContent = d.name;
    const textEl = dialogEl.querySelector(".text")!;
    dialogEl.hidden = false;
    window.clearTimeout(dialogTimer);
    window.clearInterval(typeTimer);
    // 打字机逐字上屏(尊重 prefers-reduced-motion:直接整句)
    if (reducedMotion) {
      textEl.textContent = d.text;
    } else {
      let i = 0;
      textEl.textContent = "";
      typeTimer = window.setInterval(() => {
        i += 1;
        textEl.textContent = d.text.slice(0, i);
        if (i >= d.text.length) window.clearInterval(typeTimer);
      }, 26);
    }
    dialogTimer = window.setTimeout(
      () => (dialogEl.hidden = true),
      1600 + d.text.length * 70
    );
  });
  bus.on(
    EV.panel,
    (
      p: { title: string; blurb: string; link?: { label: string; href: string } } | null
    ) => {
      if (!p) {
        panelEl.hidden = true;
        return;
      }
      panelEl.querySelector(".title")!.textContent = p.title;
      panelEl.querySelector(".blurb")!.textContent = p.blurb;
      const go = $("town-panel-link") as HTMLAnchorElement;
      if (p.link) {
        go.hidden = false;
        go.href = p.link.href;
        go.textContent = p.link.label;
      } else go.hidden = true;
      panelEl.hidden = false;
    }
  );

  $("town-panel-close")!.addEventListener("click", () => {
    panelEl.hidden = true;
    bus.emit(EV.panel, null);
  });

  // ---- 构建期数据:日记/归档/项目/友链/年报,全部来自 #town-data ----
  const TD: TownDataClient = JSON.parse(
    document.getElementById("town-data")?.textContent || "null"
  ) ?? {
    diary: [],
    posts: [],
    shelves: [],
    tags: [],
    projects: [],
    friends: [],
    stats: { posts: 0, days: 0, tags: 0, since: "" },
    socials: [],
    quote: null,
    latest: null,
    about: { author: "", bio: "" },
  };
  const diaryEl = $("town-diary")!;
  const diaryBody = $("diary-body")!;
  const diaryInd = $("diary-ind")!;
  const diaryGo = $("diary-go") as HTMLAnchorElement;
  let diaryIdx = 0;
  const renderDiary = () => {
    const e = TD.diary[diaryIdx];
    if (!e) {
      diaryBody.innerHTML = "<p>日记本还是空的。</p>";
      diaryInd.textContent = "";
      return;
    }
    const tags = e.tags.length
      ? `<p class="entry-tags px">${e.tags.map(t => `#${t}`).join(" ")}</p>`
      : "";
    diaryBody.innerHTML = `<p class="entry-date px">${e.date}</p><h3 class="entry-title">${e.title}</h3><p class="entry-desc">${e.desc || "（无摘要）"}</p>${tags}`;
    diaryInd.textContent = `${diaryIdx + 1} / ${TD.diary.length}`;
    diaryGo.href = e.href;
  };
  const openDiary = () => {
    diaryEl.hidden = false;
    renderDiary();
  };
  $("diary-prev")!.addEventListener("click", () => {
    diaryIdx = (diaryIdx - 1 + TD.diary.length) % TD.diary.length;
    renderDiary();
  });
  $("diary-next")!.addEventListener("click", () => {
    diaryIdx = (diaryIdx + 1) % TD.diary.length;
    renderDiary();
  });
  $("diary-close")!.addEventListener("click", () => {
    diaryEl.hidden = true;
    bus.emit(EV.panel, null);
  });
  bus.on(EV.diary, openDiary);

  // ---- 列表面板:场景只报 {kind,index},内容由 town-data 解析渲染 ----
  interface ListItem {
    label: string;
    meta?: string;
    desc?: string;
    href: string;
  }
  const listEl = $("town-list")!;
  const itemHtml = (it: ListItem) => {
    const desc = it.desc ? `<span class="li-d">${it.desc}</span>` : "";
    const meta = it.meta ? `<span class="li-m">${it.meta}</span>` : "";
    return `<a href="${it.href}" target="_blank" rel="noreferrer"><span class="li-main"><span class="li-t">${it.label}</span>${desc}</span>${meta}</a>`;
  };
  const resolveList = (
    r: { kind: string; index?: number }
  ): { title: string; blurb: string; items: ListItem[] } => {
    const posts = TD.posts;
    const postItems = (ps: typeof posts): ListItem[] =>
      ps.map(p => ({ label: p.t, meta: p.d, href: p.h }));
    switch (r.kind) {
      case "archive": {
        const shelf = TD.shelves[r.index ?? 0] ?? TD.shelves[0];
        if (!shelf) break;
        const ps = posts.filter(p => p.y >= shelf.from && p.y <= shelf.to);
        return {
          title: `书架 · ${shelf.label}`,
          blurb: `${ps.length} 篇,按时间排的。`,
          items: postItems(ps),
        };
      }
      case "tag": {
        const tg = TD.tags[r.index ?? 0];
        if (!tg) break;
        const ps = posts.filter(p => p.tags.includes(tg.name));
        return {
          title: `#${tg.name}`,
          blurb: `写过 ${tg.count} 次,攒了 ${ps.length} 篇。`,
          items: postItems(ps),
        };
      }
      case "projects":
        return {
          title: "工坊项目台",
          blurb: "做到一半和已经收工的,都在这张台上。",
          items: TD.projects.map(p => ({
            label: p.name,
            meta: `${p.open ? "维护中" : "已归档"} · ${p.tech}`,
            desc: p.desc,
            href: p.href,
          })),
        };
      case "annual":
        return {
          title: "小镇年报",
          blurb: `${TD.stats.since} 建镇 · 收信 ${TD.stats.posts} 封 · 写作 ${TD.stats.days} 天 · ${TD.stats.tags} 个标签。`,
          items: [
            { label: "订阅 RSS", meta: "新信自动送进阅读器", href: "/rss.xml" },
            { label: "翻全部归档", meta: "按年份", href: "/archive" },
            { label: "认识站长", meta: "/about", href: "/about" },
          ],
        };
      case "friends":
        return {
          title: "友链墙",
          blurb: "咖啡馆的常客,都是老朋友。",
          items: TD.friends.map(f => ({
            label: f.name,
            meta: "去串门",
            desc: f.desc,
            href: f.href,
          })),
        };
      case "about":
        return {
          title: "床头照片",
          blurb: TD.about.bio,
          items: [
            ...TD.socials.map(s => ({
              label: s.name,
              meta: "去打个招呼",
              href: s.href,
            })),
            { label: "关于站长", meta: "/about", href: "/about" },
          ],
        };
      case "guestbook": {
        const gb = TD.guestbook ?? { repoIssue: "", letters: [] };
        return {
          title: "邮局留言簿",
          blurb: "想留句话?去 GitHub 提个 issue,站长会誊进簿子里。",
          items: [
            ...(gb.repoIssue
              ? [
                  {
                    label: "✉ 去写一封留言",
                    meta: "GitHub issue",
                    href: gb.repoIssue,
                  },
                ]
              : []),
            ...[...gb.letters].reverse().map(l => ({
              label: `${l.from} · ${l.date}`,
              desc: l.text,
              href: gb.repoIssue || location.href,
            })),
          ],
        };
      }
    }
    return { title: "空空如也", blurb: "", items: [] };
  };
  const openList = (r: { kind: string; index?: number }) => {
    const { title, blurb, items } = resolveList(r);
    ($("list-title") as HTMLElement).textContent = title;
    ($("list-ind") as HTMLElement).textContent = `${items.length}`;
    const blurbEl = $("list-blurb") as HTMLElement;
    blurbEl.textContent = blurb;
    blurbEl.hidden = !blurb;
    ($("list-items") as HTMLElement).innerHTML = items.length
      ? items.map(itemHtml).join("")
      : `<p class="empty">还什么都没有。</p>`;
    listEl.hidden = false;
  };
  const closeList = () => {
    if (listEl.hidden) return;
    listEl.hidden = true;
    bus.emit(EV.list, null);
  };
  bus.on(EV.list, (r: { kind: string; index?: number } | null) => {
    if (r) openList(r);
  });
  $("list-close")!.addEventListener("click", closeList);

  // ---- 搜索浮层:复用站内数据,客户端 Fuse 检索 ----
  const searchEl = $("town-search")!;
  const searchInput = $("search-input") as HTMLInputElement;
  const searchResults = $("search-results")!;
  const searchDocs = TD.posts.map(p => ({
    title: p.t,
    tags: p.tags.join(" "),
    d: p.d,
    h: p.h,
  }));
  const fuse = new Fuse(searchDocs, {
    keys: ["title", "tags"],
    threshold: 0.35,
    ignoreLocation: true,
  });
  let lastFound: { title: string; d: string; h: string }[] = [];
  const renderSearch = () => {
    const q = searchInput.value.trim();
    lastFound = q ? fuse.search(q).map(r => r.item) : searchDocs.slice(0, 8);
    const items: ListItem[] = lastFound
      .slice(0, 12)
      .map(p => ({ label: p.title, meta: p.d, href: p.h }));
    searchResults.innerHTML = items.length
      ? items.map(itemHtml).join("")
      : `<p class="empty">没找到,换个词试试。</p>`;
  };
  const closeSearch = () => {
    if (searchEl.hidden) return;
    searchEl.hidden = true;
    bus.emit(EV.search, false);
  };
  bus.on(EV.search, (open: boolean) => {
    if (!open) return;
    searchEl.hidden = false;
    searchInput.value = "";
    renderSearch();
    window.setTimeout(() => searchInput.focus(), 40);
  });
  searchInput.addEventListener("input", renderSearch);
  searchInput.addEventListener("keydown", e => {
    if (e.key === "Enter" && lastFound[0])
      window.open(lastFound[0].h, "_blank", "noopener");
    if (e.key === "Escape") closeSearch();
  });
  $("search-close")!.addEventListener("click", closeSearch);

  // ESC 关浮层(焦点不在输入框时也生效)
  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    if (!listEl.hidden) closeList();
    else if (!searchEl.hidden) closeSearch();
  });

  // 昼夜切换:自动(150s 循环) → 真实(跟随本地时钟) → 白天 → 夜晚 循环;
  // 全局单例 setTod,开场屏/游戏内任何时刻切换都立即生效(场景每帧读 TOD.mode)
  const todBtn = $("town-tod") as HTMLButtonElement;
  const stage = document.querySelector(".town-stage") as HTMLElement;
  const todLabel: Record<string, string> = {
    auto: "昼夜:自动",
    real: "🕐 真实",
    day: "☀ 白天",
    night: "🌙 夜晚",
  };
  const syncTod = (v: string) => {
    todBtn.textContent = todLabel[v] ?? v;
    todBtn.dataset.mode = v;
    // 开场屏背景直接内联(类名方案被 Astro 样式作用域干扰)
    stage.style.background = v === "night" ? "#17233a" : "#2f5537";
  };
  syncTod(TOD.mode);
  todBtn.addEventListener("click", () => {
    const order: Array<"auto" | "real" | "day" | "night"> = [
      "auto",
      "real",
      "day",
      "night",
    ];
    const cur = TOD.mode;
    const next = order[(order.indexOf(cur) + 1) % order.length];
    setTod(next);
    syncTod(next);
  });

  // ---- 音效开关:默认静音,点击开启;状态交由场景音频引擎 ----
  const soundBtn = $("town-sound") as HTMLButtonElement;
  const syncSound = (on: boolean) =>
    (soundBtn.textContent = on ? "🔊 音效" : "🔇 静音");
  soundBtn.addEventListener("click", () => {
    const audio = (window as unknown as { __townAudio?: { toggle(): boolean } }).__townAudio;
    syncSound(audio ? audio.toggle() : false);
  });
  syncSound(false);

  // 虚拟方向键（pointer 事件，支持按住）
  const dpad = $("town-dpad")!;
  const dirs: Record<string, [number, number]> = {
    up: [0, -1],
    down: [0, 1],
    left: [-1, 0],
    right: [1, 0],
  };
  const held = new Set<string>();
  function sendDir() {
    let dx = 0;
    let dy = 0;
    for (const d of held) {
      dx += dirs[d][0];
      dy += dirs[d][1];
    }
    bus.emit(EV.touchDir, { dx, dy, pressed: held.size > 0 });
  }
  dpad.querySelectorAll("button").forEach(b => {
    const dir = b.dataset.dir!;
    const on = (e: PointerEvent) => {
      e.preventDefault();
      try {
        b.setPointerCapture(e.pointerId);
      } catch {
        // 合成事件/无活跃指针时捕获失败不影响按住状态
      }
      held.add(dir);
      sendDir();
    };
    const off = () => {
      held.delete(dir);
      sendDir();
    };
    b.addEventListener("pointerdown", on);
    b.addEventListener("pointerup", off);
    b.addEventListener("pointercancel", off);
    b.addEventListener("pointerleave", off);
  });
  $("town-btn-act")!.addEventListener("click", () => bus.emit(EV.touchAct));

  // ---- 小地图:站点地图的隐喻做实。M 键/按钮开关(非模态,可边走边看),
  // 点建筑瞬移(EV.travel,场景侧落到门口)。 ----
  const mapPanel = $("town-map-panel")!;
  const mapSvg = $("map-svg") as unknown as SVGSVGElement;
  const mapNs = "http://www.w3.org/2000/svg";
  const svgEl = (
    tag: string,
    attrs: Record<string, string | number>
  ): SVGElement => {
    const el = document.createElementNS(mapNs, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    return el;
  };
  const buildMap = () => {
    mapSvg.setAttribute("viewBox", `0 0 ${WORLD_W} ${WORLD_H}`);
    mapSvg.replaceChildren();
    const add = (el: SVGElement) => mapSvg.appendChild(el);
    add(svgEl("rect", { x: 0, y: 0, width: WORLD_W, height: WORLD_H, fill: "#8fb47e" }));
    // 街道与广场(与 world.buildGround 同布局)
    add(svgEl("rect", { x: 0, y: 20, width: WORLD_W, height: 2, fill: "#cfa76f" }));
    add(svgEl("rect", { x: 30, y: 0, width: 2, height: WORLD_H, fill: "#cfa76f" }));
    add(svgEl("rect", { x: 25, y: 16, width: 13, height: 10, fill: "#cfa76f" }));
    // 建筑与名字
    for (const b of buildings) {
      const r = svgEl("rect", {
        x: b.tx,
        y: b.ty,
        width: b.w,
        height: b.h,
        fill: "#a4703f",
        stroke: "#17120e",
        "stroke-width": 0.4,
        "data-id": b.id,
      });
      const t = svgEl("text", {
        x: b.tx + b.w / 2,
        y: b.ty + b.h / 2 + 1,
        "text-anchor": "middle",
        "font-size": 2.8,
        "font-weight": 700,
        fill: "#fffdf5",
      });
      t.textContent = b.name;
      add(r);
      add(t);
    }
    add(
      svgEl("circle", {
        id: "map-player",
        r: 1.2,
        cx: 32.5,
        cy: 23.5,
        fill: "#d0122a",
        stroke: "#fffdf5",
        "stroke-width": 0.35,
      })
    );
  };
  buildMap();
  bus.on(EV.playerTile, (p: { x: number; y: number }) => {
    const dot = mapSvg.querySelector("#map-player");
    if (dot) {
      dot.setAttribute("cx", String(p.x + 0.5));
      dot.setAttribute("cy", String(p.y + 0.7));
    }
  });
  mapSvg.addEventListener("click", e => {
    const id = (e.target as HTMLElement)?.getAttribute?.("data-id");
    if (!id) return;
    bus.emit(EV.travel, id);
  });
  const toggleMap = () => (mapPanel.hidden = !mapPanel.hidden);
  ($("town-map") as HTMLButtonElement).addEventListener("click", toggleMap);
  document.addEventListener("keydown", e => {
    if (e.key.toLowerCase() !== "m") return;
    const t = e.target as HTMLElement;
    if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)
      return;
    toggleMap();
  });

  // ---- 萤火虫收集角标:场景捉到时上报,3s 后收起 ----
  const toastEl = $("town-toast")!;
  let toastTimer = 0;
  bus.on(EV.collect, (c: { caught: number; total: number }) => {
    toastEl.textContent =
      c.caught >= c.total
        ? `✨ ${c.caught}/${c.total} 萤火虫都跟你回家了!`
        : `✨ 捉到萤火虫 ${c.caught}/${c.total}`;
    toastEl.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toastEl.hidden = true), 3400);
  });

  // ---- 拍照模式:P 键隐藏 HUD → 画布快照 → 加像框与日期戳 → 下载 ----
  interface PhaserLike {
    renderer: { snapshot(callback: (img: HTMLImageElement) => void): void };
  }
  const takePhoto = () => {
    const g = (window as unknown as { __townGame?: PhaserLike }).__townGame;
    if (!g) return;
    stage.classList.add("town-photo");
    window.setTimeout(() => {
      try {
        g.renderer.snapshot((img: HTMLImageElement) => {
          const cv = document.createElement("canvas");
          cv.width = img.width + 16;
          cv.height = img.height + 30;
          const ctx = cv.getContext("2d")!;
          ctx.fillStyle = "#17120e";
          ctx.fillRect(0, 0, cv.width, cv.height);
          ctx.drawImage(img, 8, 8);
          ctx.fillStyle = "#fffdf5";
          ctx.font = "10px monospace, monospace";
          ctx.fillText(
            `小圆镇 · ${new Date().toISOString().slice(0, 10)}`,
            8,
            img.height + 22
          );
          const a = document.createElement("a");
          a.href = cv.toDataURL("image/png");
          a.download = `town-${Date.now()}.png`;
          a.click();
        });
      } finally {
        window.setTimeout(() => stage.classList.remove("town-photo"), 150);
      }
    }, 130);
  };
  document.addEventListener("keydown", e => {
    if (e.key.toLowerCase() !== "p") return;
    const t = e.target as HTMLElement;
    if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)
      return;
    takePhoto();
  });

  // ---- 首次引导:出现一次,首次互动或 12s 后消失并记入 localStorage ----
  const guideEl = $("town-guide")!;
  let guideDone = false;
  try {
    guideDone = localStorage.getItem("town-onboarded") === "1";
  } catch {}
  const dismissGuide = () => {
    if (guideEl.hidden) return;
    guideEl.hidden = true;
    guideDone = true;
    try {
      localStorage.setItem("town-onboarded", "1");
    } catch {}
  };
  if (!guideDone) {
    guideEl.textContent = window.matchMedia("(pointer: coarse)").matches
      ? "虚拟键走动 · A 互动 · 🗺 地图可传送"
      : "WASD / 方向键走动 · E 互动 · M 地图(可点建筑传送)";
    guideEl.hidden = false;
    for (const ev of [EV.dialog, EV.panel, EV.diary, EV.list, EV.search])
      bus.once(ev, dismissGuide);
    window.setTimeout(dismissGuide, 12000);
  }

  // 启动：点「进入小镇」时才拉起 Phaser（按需加载，键盘锁定前先显示说明）
  let started = false;
  $("town-start")!.addEventListener("click", async () => {
    if (started) return;
    started = true;
    introEl.hidden = true;
    try {
      const { startTown } = await import("./game/scenes");
      (window as unknown as { __townGame: unknown }).__townGame = startTown(
        $("town-canvas")!
      );
    } catch (e) {
      // 启动失败必须可见:否则开场屏消失后整页像卡死
      console.error("town: startTown failed", e);
      introEl.hidden = false;
      started = false;
      const msg = e instanceof Error ? `${e.message}\n${e.stack ?? ""}` : String(e);
      (document.getElementById("town-errbar") ??
        document.body.appendChild(Object.assign(document.createElement("div"), { id: "town-errbar" }))
      ).textContent = "启动失败:\n" + msg;
      throw e;
    }
  });
</script>
