---
// 像素小镇：全屏 Phaser 画布 + DOM HUD。
// HUD 与游戏经事件总线单向通行（架构对齐 Pixels 客户端，单机简化）。
export interface DiaryEntry {
  title: string;
  date: string;
  desc: string;
  href: string;
}
export interface Props {
  diary: DiaryEntry[];
}
const { diary = [] } = Astro.props;
---

<div class="town-stage" aria-label="像素小镇">
  <div class="town-canvas" id="town-canvas"></div>

  <div class="town-hud">
    <a class="town-back px" href="/">‹ 回博客</a>
    <button class="town-tod px" id="town-tod" type="button" aria-label="切换白天黑夜">昼夜:自动</button>
  </div>

  <div class="town-prompt px" id="town-prompt" hidden></div>

  <div class="town-dialog px" id="town-dialog" hidden>
    <b class="who"></b>
    <p class="text"></p>
  </div>

  <div class="town-panel" id="town-panel" hidden>
    <div class="card">
      <h2 class="px title"></h2>
      <p class="px blurb"></p>
      <p class="px hint">按 E / ESC 关闭</p>
      <div class="row">
        <a class="px go" id="town-panel-link" hidden target="_blank" rel="noreferrer"></a>
        <button class="px close" id="town-panel-close" type="button">回到小镇</button>
      </div>
    </div>
  </div>

  <div class="town-diary" id="town-diary" hidden>
    <div class="diary-card">
      <header>
        <h2 class="px">小镇日记</h2>
        <span class="px page-ind" id="diary-ind"></span>
      </header>
      <div class="diary-body" id="diary-body"></div>
      <div class="row">
        <button class="px" id="diary-prev" type="button">◀ 上一篇</button>
        <a class="px go" id="diary-go" href="#">去读这篇</a>
        <button class="px" id="diary-next" type="button">下一篇 ▶</button>
        <button class="px close" id="diary-close" type="button">合上</button>
      </div>
    </div>
  </div>

  <div class="town-touch">
    <div class="dpad" id="town-dpad">
      <button class="du" data-dir="up" type="button" aria-label="上">▲</button>
      <button class="dl" data-dir="left" type="button" aria-label="左">◀</button>
      <button class="dr" data-dir="right" type="button" aria-label="右">▶</button>
      <button class="dd" data-dir="down" type="button" aria-label="下">▼</button>
    </div>
    <div class="acts">
      <button class="btn act px" id="town-btn-act" type="button">A</button>
    </div>
  </div>

  <div class="town-intro px" id="town-intro">
    <div class="intro-card">
      <h2>小圆镇</h2>
      <p>方向键 / WASD 走动 · E 进门、说话</p>
      <p class="dim">这就是博客的小镇形态 · 手机用屏幕按键</p>
      <button class="px start" id="town-start" type="button">进入小镇</button>
    </div>
  </div>
</div>

<script type="application/json" id="town-diary-data" set:html={JSON.stringify(diary)} />

<style>
  .town-stage {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: #2f5537;
    transition: background 0.4s;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .town-canvas,
  .town-canvas canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .town-hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    pointer-events: none;
    z-index: 5;
  }
  .town-tod {
    pointer-events: auto;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 10px;
    font-size: 12px;
    color: #17120e;
    cursor: pointer;
  }
  .town-back {
    pointer-events: auto;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 4px 10px;
    text-decoration: none;
    color: #17120e;
  }
  .town-prompt {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 108px;
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 3px 3px 0 rgb(23 18 14 / 0.7);
    padding: 3px 10px;
    z-index: 5;
    white-space: nowrap;
  }
  .town-dialog {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    width: min(560px, calc(100% - 24px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 4px 4px 0 rgb(23 18 14 / 0.7);
    padding: 8px 12px;
    z-index: 6;
  }
  .town-dialog .who {
    color: #d0122a;
    margin-right: 8px;
  }
  .town-dialog .text {
    display: inline;
    margin: 0;
  }
  .town-touch {
    position: absolute;
    inset: auto 0 0 0;
    display: none;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 14px 90px;
    z-index: 6;
    pointer-events: none;
  }
  .town-touch button {
    pointer-events: auto;
  }
  .dpad {
    position: relative;
    width: 132px;
    height: 132px;
  }
  .dpad button {
    position: absolute;
    width: 44px;
    height: 44px;
    background: #fffdf5cc;
    border: 2px solid #17120e;
    font-size: 13px;
  }
  .dpad .du { left: 44px; top: 0; }
  .dpad .dl { left: 0; top: 44px; }
  .dpad .dr { left: 88px; top: 44px; }
  .dpad .dd { left: 44px; top: 88px; }
  .acts {
    display: grid;
    gap: 8px;
  }
  .acts .btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #ffd2d2cc;
    border: 2px solid #17120e;
  }
  @media (pointer: coarse) {
    .town-touch { display: flex; }
  }
  .town-panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.45);
    z-index: 8;
  }
  .town-panel .card {
    width: min(420px, calc(100% - 40px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 6px 6px 0 rgb(23 18 14 / 0.6);
    padding: 16px 18px;
  }
  .town-panel .title {
    margin: 0 0 6px;
    color: #d0122a;
  }
  .town-panel .blurb {
    margin: 0 0 8px;
    line-height: 1.6;
  }
  .town-panel .hint {
    margin: 0 0 10px;
    opacity: 0.55;
    font-size: 12px;
  }
  .town-panel .row {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .town-panel .go,
  .town-panel .close {
    background: #17120e;
    color: #fffdf5;
    border: 0;
    padding: 6px 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .town-panel .go { background: #d0122a; }
  .town-intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.72);
    z-index: 9;
  }
  .town-intro .intro-card {
    text-align: center;
    color: #fffdf5;
    line-height: 2;
  }
  .town-intro h2 {
    font-size: 30px;
    letter-spacing: 6px;
    margin: 0 0 8px;
  }
  .town-intro .dim { opacity: 0.65; }
  .town-intro .start {
    margin-top: 10px;
    background: #d0122a;
    color: #fff;
    border: 2px solid #fffdf5;
    padding: 8px 22px;
    cursor: pointer;
  }
  .town-diary {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(12 10 8 / 0.55);
    z-index: 9;
  }
  .town-diary[hidden] { display: none; }
  .town-diary .diary-card {
    width: min(520px, calc(100% - 40px));
    background: #fffdf5;
    border: 2px solid #17120e;
    box-shadow: 6px 6px 0 rgb(23 18 14 / 0.6);
    padding: 16px 18px 14px;
  }
  .town-diary header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid #17120e;
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  .town-diary h2 {
    margin: 0;
    font-size: 18px;
    color: #d0122a;
  }
  .town-diary .page-ind { font-size: 12px; color: #55585f; }
  .town-diary .diary-body { min-height: 120px; }
  .town-diary .entry-date {
    margin: 0 0 4px;
    font-size: 12px;
    color: #d0122a;
  }
  .town-diary .entry-title {
    margin: 0 0 8px;
    font-size: 17px;
    line-height: 1.45;
  }
  .town-diary .entry-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: #44444a;
  }
  .town-diary .row {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .town-diary .row button,
  .town-diary .row .go {
    background: #17120e;
    color: #fffdf5;
    border: 0;
    padding: 6px 10px;
    font-size: 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .town-diary .row .go { background: #d0122a; }
  .town-diary .row .close { margin-left: auto; background: #55585f; }
  .town-intro[hidden] { display: none; }
  .town-panel[hidden] { display: none; }
  .town-dialog[hidden] { display: none; }
  .town-prompt[hidden] { display: none; }
</style>

<script>
  import { bus, EV, TOD, setTod } from "./game/state";

  // 未捕获错误可视化（仅出错时出现）
  window.addEventListener("error", e => {
    let el = document.getElementById("town-errbar");
    if (!el) {
      el = document.createElement("div");
      el.id = "town-errbar";
      el.style.cssText =
        "position:fixed;bottom:0;left:0;right:0;z-index:99;background:#a00;color:#fff;font:11px monospace;padding:4px;max-height:120px;overflow:auto;white-space:pre-wrap";
      document.body.appendChild(el);
    }
    el.textContent += `\n${e.message}\n${e.filename}:${e.lineno}:${e.colno}\n${
      e.error?.stack ?? ""
    }`;
  });

  const $ = (id: string) => document.getElementById(id);
  const promptEl = $("town-prompt")!;
  const dialogEl = $("town-dialog")!;
  const panelEl = $("town-panel")!;
  const introEl = $("town-intro")!;

  bus.on(EV.ready, () => introEl.querySelector("button")?.removeAttribute("disabled"));
  bus.on(EV.prompt, (text: string | null) => {
    if (!text) {
      promptEl.hidden = true;
      return;
    }
    promptEl.textContent = text;
    promptEl.hidden = false;
  });
  let dialogTimer = 0;
  bus.on(EV.dialog, (d: { name: string; text: string } | null) => {
    if (!d) {
      dialogEl.hidden = true;
      return;
    }
    dialogEl.querySelector(".who")!.textContent = d.name;
    dialogEl.querySelector(".text")!.textContent = d.text;
    dialogEl.hidden = false;
    window.clearTimeout(dialogTimer);
    dialogTimer = window.setTimeout(() => (dialogEl.hidden = true), 4200);
  });
  bus.on(
    EV.panel,
    (
      p: { title: string; blurb: string; link?: { label: string; href: string } } | null
    ) => {
      if (!p) {
        panelEl.hidden = true;
        return;
      }
      panelEl.querySelector(".title")!.textContent = p.title;
      panelEl.querySelector(".blurb")!.textContent = p.blurb;
      const go = $("town-panel-link") as HTMLAnchorElement;
      if (p.link) {
        go.hidden = false;
        go.href = p.link.href;
        go.textContent = p.link.label;
      } else go.hidden = true;
      panelEl.hidden = false;
    }
  );

  $("town-panel-close")!.addEventListener("click", () => {
    panelEl.hidden = true;
    bus.emit(EV.panel, null);
  });

  // ---- 小镇日记:内容由构建期从最新文章注入 ----
  const diary: Array<{ title: string; date: string; desc: string; href: string }> =
    JSON.parse(document.getElementById("town-diary-data")?.textContent || "[]");
  const diaryEl = $("town-diary")!;
  const diaryBody = $("diary-body")!;
  const diaryInd = $("diary-ind")!;
  const diaryGo = $("diary-go") as HTMLAnchorElement;
  let diaryIdx = 0;
  const renderDiary = () => {
    const e = diary[diaryIdx];
    if (!e) {
      diaryBody.innerHTML = "<p>日记本还是空的。</p>";
      diaryInd.textContent = "";
      return;
    }
    diaryBody.innerHTML = `<p class="entry-date px">${e.date}</p><h3 class="entry-title">${e.title}</h3><p class="entry-desc">${e.desc || "（无摘要）"}</p>`;
    diaryInd.textContent = `${diaryIdx + 1} / ${diary.length}`;
    diaryGo.href = e.href;
  };
  const openDiary = () => {
    diaryEl.hidden = false;
    renderDiary();
  };
  $("diary-prev")!.addEventListener("click", () => {
    diaryIdx = (diaryIdx - 1 + diary.length) % diary.length;
    renderDiary();
  });
  $("diary-next")!.addEventListener("click", () => {
    diaryIdx = (diaryIdx + 1) % diary.length;
    renderDiary();
  });
  $("diary-close")!.addEventListener("click", () => {
    diaryEl.hidden = true;
    bus.emit(EV.panel, null);
  });
  bus.on(EV.diary, openDiary);

  // 昼夜切换:自动(按本地时间) → 白天 → 夜晚 循环;全局单例 setTod,
  // 开场屏/游戏内任何时刻切换都立即生效(场景每帧读 TOD.mode)
  const todBtn = $("town-tod") as HTMLButtonElement;
  const stage = document.querySelector(".town-stage") as HTMLElement;
  const todLabel: Record<string, string> = {
    auto: "昼夜:自动",
    day: "☀ 白天",
    night: "🌙 夜晚",
  };
  const syncTod = (v: string) => {
    todBtn.textContent = todLabel[v] ?? v;
    todBtn.dataset.mode = v;
    // 开场屏背景直接内联(类名方案被 Astro 样式作用域干扰)
    stage.style.background = v === "night" ? "#17233a" : "#2f5537";
  };
  syncTod(TOD.mode);
  todBtn.addEventListener("click", () => {
    const order: Array<"auto" | "day" | "night"> = ["auto", "day", "night"];
    const cur = TOD.mode;
    const next = order[(order.indexOf(cur) + 1) % order.length];
    setTod(next);
    syncTod(next);
  });

  // 虚拟方向键（pointer 事件，支持按住）
  const dpad = $("town-dpad")!;
  const dirs: Record<string, [number, number]> = {
    up: [0, -1],
    down: [0, 1],
    left: [-1, 0],
    right: [1, 0],
  };
  const held = new Set<string>();
  function sendDir() {
    let dx = 0;
    let dy = 0;
    for (const d of held) {
      dx += dirs[d][0];
      dy += dirs[d][1];
    }
    bus.emit(EV.touchDir, { dx, dy, pressed: held.size > 0 });
  }
  dpad.querySelectorAll("button").forEach(b => {
    const dir = b.dataset.dir!;
    const on = (e: PointerEvent) => {
      e.preventDefault();
      try {
        b.setPointerCapture(e.pointerId);
      } catch {
        // 合成事件/无活跃指针时捕获失败不影响按住状态
      }
      held.add(dir);
      sendDir();
    };
    const off = () => {
      held.delete(dir);
      sendDir();
    };
    b.addEventListener("pointerdown", on);
    b.addEventListener("pointerup", off);
    b.addEventListener("pointercancel", off);
    b.addEventListener("pointerleave", off);
  });
  $("town-btn-act")!.addEventListener("click", () => bus.emit(EV.touchAct));

  // 启动：点「进入小镇」时才拉起 Phaser（按需加载，键盘锁定前先显示说明）
  let started = false;
  $("town-start")!.addEventListener("click", async () => {
    if (started) return;
    started = true;
    introEl.hidden = true;
    try {
      const { startTown } = await import("./game/scenes");
      (window as unknown as { __townGame: unknown }).__townGame = startTown(
        $("town-canvas")!
      );
    } catch (e) {
      // 启动失败必须可见:否则开场屏消失后整页像卡死
      console.error("town: startTown failed", e);
      introEl.hidden = false;
      started = false;
      const msg = e instanceof Error ? `${e.message}\n${e.stack ?? ""}` : String(e);
      (document.getElementById("town-errbar") ??
        document.body.appendChild(Object.assign(document.createElement("div"), { id: "town-errbar" }))
      ).textContent = "启动失败:\n" + msg;
      throw e;
    }
  });
</script>
