---
import formatDotDate from "@utils/formatDotDate";
import type { CollectionEntry } from "astro:content";

export interface Props {
  posts: CollectionEntry<"blogs">[];
}

const { posts } = Astro.props;
const sprites = [
  ["house-r", 90, 60],
  ["tree", 80, 80],
  ["house-n", 90, 60],
  ["person-r", 90, 90],
  ["house-b", 90, 60],
  ["person-b", 70, 80],
  ["house-t", 90, 60],
  ["tulip", 70, 110],
  ["person-bike", 90, 90],
  ["house-m", 90, 60],
  ["train", 100, 60],
  ["dandelion", 50, 70],
  ["lh", 110, 120],
  ["bee", 70, 50],
  ["person-g", 70, 80],
] as const;
const live = posts.slice(0, 8);
const deco = /^(tree|bee|tulip|dandelion)$/;
let pi = 0;
const cells = sprites.map(([name, w, h]) => {
  const idx = !deco.test(name) && pi < live.length ? pi++ : -1;
  return { name, w, h, post: idx >= 0 ? live[idx] : null, extra: idx >= 6 };
});
---

<div class="ara-street">
  <span class="ara-street-hint px">点房子或人 · 进最新几篇</span>
  <div class="ara-ground">
    {
      cells.map(({ name, w, h, post, extra }) =>
        post ? (
          <a class:list={["spr", { "spr-extra": extra }]} href={`/blog/${post.id}`}>
            <img
              class="px"
              src={`/ara/sprites/${name}.png`}
              alt={post.data.title}
              width={w}
              height={h}
              style={`--sw: ${w}`}
            />
            <span class="tip px" aria-hidden="true">
              {formatDotDate(post.data.date).slice(2)} · {post.data.title}
            </span>
            <span class="dot" aria-hidden="true" />
          </a>
        ) : (
          <span class="spr deco" aria-hidden="true">
            <img
              class="px"
              src={`/ara/sprites/${name}.png`}
              alt=""
              width={w}
              height={h}
              style={`--sw: ${w}`}
            />
          </span>
        )
      )
    }
  </div>
</div>

<script>
  // 触屏两段式：第一次点房子只显示标题，再点同一座才进文章；有 hover 的设备不受影响
  const ground = document.querySelector(".ara-ground");
  if (ground && matchMedia("(hover: none), (pointer: coarse)").matches) {
    ground.addEventListener("click", e => {
      const a = e.target.closest("a.spr");
      if (!a || a.dataset.armed) return;
      e.preventDefault();
      ground
        .querySelectorAll("a.spr[data-armed]")
        .forEach(s => delete s.dataset.armed);
      a.dataset.armed = "1";
    });
  }
</script>
