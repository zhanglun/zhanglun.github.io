---
import { CURSORS, FACES, ROBOT, URLS } from "./assets";

export interface Props {
  compact?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
  tagline?: string;
  heading?: string;
}

const {
  compact = false,
  ctaHref = "#",
  ctaLabel = "TALK TO THE PIXELS",
  tagline = "Take the cursor for a walk. Reverse-engineered with REA.",
  heading = "PIXEL STYLE DEMO",
} = Astro.props;
---

<section class:list={["px-banner", { "is-compact": compact }]} id="pixel-banner">
  <canvas id="stage-canvas" aria-hidden="true"></canvas>

  <div class="banner-heading">
    <div class="banner-logo">
      <img src={URLS.mark} alt="" width="56" height="56" />
      <h1 class="px-heading">{heading}</h1>
    </div>
    <p class="banner-tagline">{tagline}</p>
  </div>

  <div class="banner-characters" aria-hidden="true">
    <figure class="face face--a px-float">
      <img
        src={FACES["teacher-01"].def}
        alt=""
        width="144"
        height="144"
        data-gaze
        data-face-id="teacher-01"
        data-facing="left"
      />
    </figure>
    <figure class="face face--b px-float">
      <img
        src={FACES["teacher-02"].def}
        alt=""
        width="216"
        height="216"
        data-gaze
        data-face-id="teacher-02"
        data-facing="left"
      />
    </figure>
    <figure class="face face--c px-float">
      <img
        src={FACES["teacher-03"].def}
        alt=""
        width="180"
        height="180"
        data-gaze
        data-face-id="teacher-03"
        data-facing="left"
      />
    </figure>
    <figure class="robot-fig robot--1 px-float">
      <img src={ROBOT.closed} alt="" width="72" height="72" />
    </figure>
    <figure class="robot-fig robot--2 px-float">
      <img src={ROBOT.open} alt="" width="72" height="72" />
    </figure>
  </div>

  <div class="banner-actions">
    <div class="cta-wrap">
      <span class="burst-face burst-face--a" aria-hidden="true">
        <img src={CURSORS.heart.src} alt="" width="14" height="14" />
      </span>
      <span class="burst-face burst-face--b" aria-hidden="true">
        <img src={CURSORS.question.src} alt="" width="14" height="14" />
      </span>
      <span class="burst-face burst-face--c" aria-hidden="true">
        <img src={CURSORS.voice.src} alt="" width="14" height="14" />
      </span>
      <a id="cta" href={ctaHref} data-cursor="mail" data-pixel-cta>
        <img src={URLS.mail} alt="" width="20" height="20" />
        <span>{ctaLabel}</span>
      </a>
    </div>
    <div class="cursor-lab" aria-label="cursor playground">
      <span class="chip" data-cursor="question">
        <img src={CURSORS.question.src} alt="" width="18" height="18" />
        <span>？</span>
      </span>
      <span class="chip" data-cursor="heart">
        <img src={CURSORS.heart.src} alt="" width="18" height="18" />
        <span>HEART</span>
      </span>
      <span class="chip" data-cursor="voice">
        <img src={CURSORS.voice.src} alt="" width="18" height="18" />
        <span>VOICE</span>
      </span>
      <span class="chip" data-cursor="robot">
        <img src={CURSORS.robot.src} alt="" width="18" height="18" />
        <span>ROBOT</span>
      </span>
      <span class="chip" data-cursor="bunjiro">
        <img src={CURSORS.bunjiro.src} alt="" width="18" height="18" />
        <span>BUNJIRO</span>
      </span>
    </div>
  </div>
</section>

<style>
  .px-banner {
    position: relative;
    height: 100svh;
    min-height: 620px;
  }

  .px-banner.is-compact {
    height: 74svh;
    min-height: 540px;
  }

  #stage-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    image-rendering: pixelated;
  }

  .banner-heading {
    position: absolute;
    top: 14%;
    left: 0;
    right: 0;
    text-align: center;
    padding: 0 24px;
  }

  .banner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .banner-logo img {
    width: 56px;
    height: 56px;
  }

  .banner-logo h1 {
    font-size: clamp(30px, 5vw, 54px);
  }

  .banner-tagline {
    margin: 16px 0 0;
    font-family: var(--px-pixel-font);
    font-size: clamp(13px, 1.6vw, 18px);
    color: #44444a;
    letter-spacing: 0.04em;
  }

  .banner-characters {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .banner-characters figure {
    position: absolute;
    margin: 0;
  }

  .banner-characters img {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }

  .face {
    width: 144px;
    height: 144px;
  }

  .face--a {
    left: 11%;
    top: 44%;
  }

  .face--b {
    left: calc(50% - 108px);
    top: 32%;
    width: 216px;
    height: 216px;
    animation-delay: -0.6s;
  }

  .face--c {
    right: 9%;
    top: 38%;
    width: 180px;
    height: 180px;
    animation-delay: -1.1s;
  }

  .robot-fig {
    width: 72px;
    height: 72px;
  }

  .robot--1 {
    left: 25%;
    top: 26%;
  }

  .robot--2 {
    right: 23%;
    top: 27%;
    animation-delay: -0.9s;
  }

  .banner-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 0 24px;
  }

  .cta-wrap {
    position: relative;
  }

  #cta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--px-pixel-font);
    font-size: 17px;
    letter-spacing: 0.08em;
    color: var(--px-paper);
    background: var(--px-ink);
    border: 2px solid var(--px-ink);
    padding: 15px 26px;
    text-decoration: none;
    box-shadow: 5px 5px 0 rgba(17, 17, 20, 0.25);
  }

  #cta img {
    width: 20px;
    height: 20px;
    filter: invert(1);
  }

  #cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 rgba(17, 17, 20, 0.3);
  }

  .burst-face {
    position: absolute;
    width: 22px;
    height: 22px;
    background: var(--px-red);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: px-pop 1.2s steps(2, jump-none) infinite;
  }

  .burst-face img {
    width: 14px;
    height: 14px;
    filter: invert(1);
  }

  .burst-face--a { left: -30px; top: -14px; }
  .burst-face--b { right: -30px; top: 8px; animation-delay: -0.4s; }
  .burst-face--c { right: 14px; top: -24px; animation-delay: -0.8s; }

  @keyframes px-pop {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .cursor-lab {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--px-pixel-font);
    font-size: 11px;
    letter-spacing: 0.05em;
    border: 2px solid var(--px-ink);
    background: var(--px-paper);
    padding: 6px 10px;
    box-shadow: 3px 3px 0 var(--px-ink);
    user-select: none;
  }

  .chip img {
    width: 18px;
    height: 18px;
  }

  .chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--px-ink);
  }

  @media (max-width: 780px) {
    .face,
    .face--c {
      width: 108px;
      height: 108px;
    }

    .face--b {
      width: 144px;
      height: 144px;
      left: calc(50% - 72px);
    }

    .robot--2 {
      display: none;
    }

    #cta {
      font-size: 15px;
      padding: 13px 20px;
    }
  }
</style>
