---
import Layout from "./Layout.astro";
import CatNav from "@components/ara/CatNav.astro";
import PostList from "@components/ara/PostList.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  allPosts: CollectionEntry<"blogs">[];
}

const { allPosts } = Astro.props;
const years: { year: string; posts: CollectionEntry<"blogs">[] }[] = [];
for (const post of allPosts) {
  const year = String(post.data.date.getFullYear());
  if (!years.length || years[years.length - 1].year !== year) {
    years.push({ year, posts: [] });
  }
  years[years.length - 1].posts.push(post);
}
---

<Layout title={`文章 | 张小伦的网络日志`} active="blogs">
  <div class="ara-body">
    <CatNav active="blogs" />
    <div class="ara-main">
      <h2 class="px">全部文章</h2>
      {
        years.map(group => (
          <div>
            <div class="year px">{group.year}</div>
            <PostList posts={group.posts} />
          </div>
        ))
      }
    </div>
  </div>
</Layout>
