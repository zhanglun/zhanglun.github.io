---
import { SITE } from "src/config";
import Street from "@components/ara/Street.astro";
import "../styles/index.css";
import type { CollectionEntry } from "astro:content";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  active?: string;
  streetPosts?: CollectionEntry<"blogs">[];
  posting?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.description,
  ogImage = SITE.ogImage,
  active,
  streetPosts,
  posting = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(
  ogImage ? ogImage : SITE.ogImage,
  Astro.url.origin
).href;
const fallbackImageURL = new URL(SITE.ogImage, Astro.url.origin).href;

const nav = [
  ["home", "首页", "/"],
  ["blogs", "文章", "/blog"],
  ["search", "搜索", "/search"],
  ["projects", "项目", "/projects"],
  ["about", "关于", "/about"],
] as const;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={socialImageURL.endsWith(".svg")
        ? fallbackImageURL
        : socialImageURL}
    />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NV80H5X8DD"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-NV80H5X8DD");
    </script>
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
  </head>
  <body>
    <!--
THESIS: 白底目录站。街景只在首页全宽可点；内页两栏读字。拒绝整页游戏皮和长文点阵。
OWN-WORLD: #fff/#f3f3f3 纸地，#111 墨线，#d0122a 邮戳。Fusion Pixel 只做标题和标签；正文衬线 18px。原创像素房子/人/灯塔当物件。
STORY: 读者看见一份中文技术日志，点街景或目录就能读到真文章。
FIRST VIEWPORT: 顶栏小人+站名+中文导航；其下一排可点街景；下为左分类右最新一篇。
FORM: Ara Town，seed 67556832。
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
    <a class="skip px" href="#main-content">跳到主要内容</a>
    <div class:list={["ara-site", { "is-posting": posting }]}>
      <header class="ara-head" id="top">
        <a class="ara-brand" href="/">
          <img class="px" src="/ara/sprites/person-b.png" alt="" height="48" />
          <span>
            <strong class="px">{SITE.title}</strong>
            <em class="px">写给以后翻看</em>
          </span>
        </a>
        <div></div>
        <nav class="ara-nav px" aria-label="站点">
          {
            nav.map(([id, label, href]) => (
              <a
                href={href}
                aria-current={active === id ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
      </header>
      {streetPosts && <Street posts={streetPosts} />}
      <main id="main-content">
        <slot />
      </main>
      <footer class="ara-foot px">
        <span>© <span data-year>{new Date().getFullYear()}</span> {SITE.author}</span>
        <nav class="foot-links" aria-label="页脚">
          <a href="https://github.com/zhanglun">GitHub</a>
          <a href="mailto:zhanglun1410@gmail.com">邮箱</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <img
          class="px foot-obstacle foot-obstacle-a"
          src="/ara/sprites/tulip.png"
          alt=""
          width="19"
          height="30"
          loading="lazy"
        />
        <img
          class="px foot-obstacle foot-obstacle-b"
          src="/ara/sprites/crate.png"
          alt=""
          width="28"
          height="24"
          loading="lazy"
        />
        <div class="crab-track">
          <div class="crab-walk">
            <div class="crab-hop">
              <div class="crab-flip">
                <img
                  class="px foot-crab"
                  src="/ara/sprites/crab.png"
                  alt=""
                  width="36"
                  height="24"
                />
              </div>
            </div>
          </div>
        </div>
      </footer>
    </div>
    <script>
      // 年份随客户端刷新，静态缓存的页面不会停在旧年
      document
        .querySelectorAll("[data-year]")
        .forEach(el => (el.textContent = String(new Date().getFullYear())));

      // 巡逻蟹巡线：运行时实测几何 → WAAPI 动态关键帧（闭合回路，任意视口宽度都准确）。
      // ponytail: 不引物理库——装饰编排需要的是实测几何，不是刚体响应；WAAPI 原生够用。
      const foot = document.querySelector(".ara-foot");
      const track = foot && foot.querySelector(".crab-track");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      if (foot && track && !reduced.matches && Element.prototype.animate) {
        const walkEl = track.querySelector(".crab-walk");
        const hopEl = track.querySelector(".crab-hop");
        const flipEl = track.querySelector(".crab-flip");
        const crabImg = track.querySelector(".foot-crab");
        let anims = [];

        function build() {
          anims.forEach(a => a.cancel());
          anims = [];
          const trackRect = track.getBoundingClientRect();
          const T = trackRect.width;
          if (T <= 0) return;
          const crabW = crabImg.getBoundingClientRect().width || 36;
          const cruise = (2 * T) / 15000; // px/ms：行走预算约 15s
          const burst = cruise * 1.8; // 起跳扑跳加速（猫 physical burst）
          const creep = cruise * 0.5;
          const pad = 6; // 猫剪影（耳/尾）超出碰撞盒的经验余量

          // 实测障碍：中心 / 宽 / 高（资产已裁为实心满幅，重排/改尺寸自动跟随）
          const obstacles = [...foot.querySelectorAll(".foot-obstacle")]
            .map(o => {
              const r = o.getBoundingClientRect();
              return { c: r.left + r.width / 2 - trackRect.left, w: r.width, h: r.height };
            })
            .filter(o => o.c > 0 && o.c < T)
            .sort((a, b) => a.c - b.c);

          // 单次跳跃：弧形按目标宽高比反推——重叠边缘落在抛物线 u=0.62 处、
          // 边缘净空 5px，滞空时间 = 窗宽/扑跳速（约 0.45–0.55s，游戏手感而非气球滑翔）
          function jumpFor(ob) {
            const overlapHalf = (crabW + ob.w) / 2 + pad;
            const u = 0.62;
            const H = (ob.h + 5) / (1 - u * u);
            return { passX: ob.c - crabW / 2, halfPx: overlapHalf / u, H };
          }

          const xPins = [];
          const hops = [];
          let t = 0;
          let x = T;
          const push = (dt, nx) => {
            t += Math.max(0, dt);
            x = nx;
            xPins.push({ t, x });
          };
          xPins.push({ t: 0, x });

          // 右 → 左：爬行起步 → 巡行，逐障碍起跳
          push((T - 0.94 * T) / creep, 0.94 * T);
          for (const ob of [...obstacles].reverse()) {
            const j = jumpFor(ob);
            const sX = j.passX + j.halfPx;
            const eX = j.passX - j.halfPx;
            push((x - sX) / cruise, sX);
            const dt = (sX - eX) / burst;
            hops.push({ t0: t, t1: t + dt, H: j.H });
            push(dt, eX);
          }
          push((x - 0.054 * T) / cruise, 0.054 * T);
          push((0.054 * T) / creep, 0);
          const flipA = t + 420;
          t = flipA;
          xPins.push({ t, x });

          // 左 → 右：镜像
          push((0.06 * T) / creep, 0.06 * T);
          for (const ob of obstacles) {
            const j = jumpFor(ob);
            const sX = j.passX - j.halfPx;
            const eX = j.passX + j.halfPx;
            push((sX - x) / cruise, sX);
            const dt = (eX - sX) / burst;
            hops.push({ t0: t, t1: t + dt, H: j.H });
            push(dt, eX);
          }
          push((0.946 * T - x) / cruise, 0.946 * T);
          push((T - 0.946 * T) / creep, T);
          const flipB = t + 420;
          t = flipB + 480; // 转身后小驻，接缝自然
          xPins.push({ t, x: T });
          const total = t;

          // X：线性分段（分段速度即步态节奏）
          const kx = xPins.map(p => ({
            transform: `translate(${p.x.toFixed(1)}px, 0)`,
            offset: p.t / total,
            easing: "linear",
          }));

          // Y：抛物线——升段减速 / 降段加速，顶点速度为零
          const RISE = "cubic-bezier(0.33, 0.67, 0.67, 1)";
          const FALL = "cubic-bezier(0.33, 0, 0.67, 0.33)";
          const ky = [{ transform: "translateY(0)", offset: 0 }];
          for (const h of hops) {
            const t0o = h.t0 / total;
            const mid = (h.t0 + (h.t1 - h.t0) / 2) / total;
            const t1o = h.t1 / total;
            // 起跳地面帧：没有它，上升段会从上一个关键帧（上一个落点或 offset 0）
            // 开始缓动，猫会在障碍前老远开始飘升——实测滞空 2.5s 的真凶
            if (t0o > ky[ky.length - 1].offset) {
              ky.push({ transform: "translateY(0)", offset: t0o, easing: RISE });
            }
            ky.push({
              transform: `translateY(-${h.H.toFixed(1)}px)`,
              offset: mid,
              easing: FALL,
            });
            ky.push({ transform: "translateY(0)", offset: t1o, easing: RISE });
          }
          ky.push({ transform: "translateY(0)", offset: 1 });

          // 折返翻转（瞬时）
          const a = flipA / total;
          const b = flipB / total;
          const kf = [
            { transform: "scaleX(1)", offset: 0 },
            { transform: "scaleX(1)", offset: Math.max(0, a - 0.0005) },
            { transform: "scaleX(-1)", offset: Math.min(1, a + 0.0005) },
            { transform: "scaleX(-1)", offset: Math.max(0, b - 0.0005) },
            { transform: "scaleX(1)", offset: Math.min(1, b + 0.0005) },
            { transform: "scaleX(1)", offset: 1 },
          ];

          anims = [
            walkEl.animate(kx, { duration: total, iterations: Infinity }),
            hopEl.animate(ky, { duration: total, iterations: Infinity }),
            flipEl.animate(kf, { duration: total, iterations: Infinity }),
          ];
        }

        build();
        let raf = 0;
        new ResizeObserver(() => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(build);
        }).observe(foot);
        if ("IntersectionObserver" in window) {
          new IntersectionObserver(entries => {
            const on = entries[entries.length - 1].isIntersecting;
            anims.forEach(a => (on ? a.play() : a.pause()));
          }).observe(foot);
        }
      }
    </script>
  </body>
</html>
